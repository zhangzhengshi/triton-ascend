// Fixed FP32 arithmetic probes. OP: add/sub/mul/max = 0/1/2/3.
#include "RegBase/VecUtils.h"
#include "Utils.h"
#include "Vector/VecUtils.h"
#ifndef ARITH_ROUTE
#define ARITH_ROUTE 0
#endif
#ifndef ARITH_OP
#define ARITH_OP 0
#endif
static_assert(ARITH_ROUTE == 0 || ARITH_ROUTE == 1,
              "route must be SIMD or SIMT");
static_assert(ARITH_OP >= 0 && ARITH_OP <= 3, "unsupported operation");
constexpr int NT = 1024, C = 8, ACTIVE = ARITH_ROUTE ? NT : 64;
#define CHAINS(F) F(0) F(1) F(2) F(3) F(4) F(5) F(6) F(7)

__simt_vf__ LAUNCH_BOUND(NT)
__aiv__ static void initialize(__gm__ uint32_t *gm, __ubuf__ float *input) {
  int t = threadIdx.y * 32 + threadIdx.x;
  auto typed = reinterpret_cast<__gm__ float *>(gm);
  if (t < ACTIVE)
    for (int c = 0; c < 2 * C; ++c)
      input[c * ACTIVE + t] = typed[c * ACTIVE + t];
}

#if ARITH_ROUTE == 1
__simt_vf__ LAUNCH_BOUND(NT)
__aiv__ static void work(__ubuf__ float *input, __ubuf__ float *dst,
                         int iterations) {
  int t = threadIdx.y * 32 + threadIdx.x;
  float base = input[t], operand = input[C * ACTIVE + t];
  float x0 = base, x1 = base + 0.01f, x2 = base + 0.02f;
  float x3 = base + 0.03f, x4 = base + 0.04f, x5 = base + 0.05f;
  float x6 = base + 0.06f, x7 = base + 0.07f;
#if ARITH_OP == 0
#define STEP(I) x##I += operand;
#elif ARITH_OP == 1
#define STEP(I) x##I -= operand;
#elif ARITH_OP == 2
#define STEP(I) x##I *= operand;
#else
#define STEP(I) x##I = __fmaxf(x##I, operand);
#endif
  // One target per chain per runtime iteration, matching the low-unroll core.
  for (int r = 0; r < iterations; ++r) {
    CHAINS(STEP)
  }
#undef STEP
  dst[t] = x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7;
}
#else
__aiv__ __attribute__((always_inline)) static void work(__ubuf__ float *input,
                                                        int iterations) {
  __VEC_SCOPE__ {
    vector_bool mask;
    uint32_t lanes = 64;
    CREATE_MASK_BY_SIZE(mask, float, lanes);
    vector_f32 operand;
    vlds(operand, input + C * ACTIVE, 0, NORM);
#define LOAD(I)                                                                \
  vector_f32 x##I;                                                             \
  vlds(x##I, input + I * ACTIVE, 0, NORM);
    CHAINS(LOAD)
#undef LOAD
#if ARITH_OP == 0
#define STEP(I) vadd(x##I, x##I, operand, mask);
#elif ARITH_OP == 1
#define STEP(I) vsub(x##I, x##I, operand, mask);
#elif ARITH_OP == 2
#define STEP(I) vmul(x##I, x##I, operand, mask);
#else
#define STEP(I) vmax(x##I, x##I, operand, mask);
#endif
    for (uint16_t r = 0; r < static_cast<uint16_t>(iterations); ++r) {
      CHAINS(STEP)
    }
#undef STEP
    // The measured SIMD probe carries the recurrence across the K calls.
#define SAVE(I) vsts(x##I, input + I * ACTIVE, 0, NORM_B32, mask);
    CHAINS(SAVE)
#undef SAVE
  }
}
#endif

__simt_vf__ LAUNCH_BOUND(NT)
__aiv__ static void readback(__ubuf__ float *input, __ubuf__ float *dst,
                             __gm__ uint32_t *gm) {
  int t = threadIdx.y * 32 + threadIdx.x;
  auto typed = reinterpret_cast<__gm__ float *>(gm);
  if (t < ACTIVE) {
#if ARITH_ROUTE == 1
    typed[2 * C * ACTIVE + t] = dst[t];
#else
    for (int c = 0; c < C; ++c)
      typed[(2 * C + c) * ACTIVE + t] = input[c * ACTIVE + t];
#endif
  }
}

extern "C" __global__[aicore] void
measure(__gm__ long long *out, __gm__ uint32_t *gm, int K, int iterations) {
  auto input = reinterpret_cast<__ubuf__ float *>(0);
  auto dst = reinterpret_cast<__ubuf__ float *>(65536);
  cce::async_invoke<initialize>(cce::dim3{32, NT / 32, 1}, gm, input);
  pipe_barrier(PIPE_ALL);
  long long start = get_sys_cnt();
  for (int k = 0; k < K; ++k) {
#if ARITH_ROUTE == 1
    cce::async_invoke<work>(cce::dim3{32, NT / 32, 1}, input, dst, iterations);
#else
    work(input, iterations);
#endif
    pipe_barrier(PIPE_ALL);
  }
  out[0] = get_sys_cnt() - start;
  cce::async_invoke<readback>(cce::dim3{32, NT / 32, 1}, input, dst, gm);
  pipe_barrier(PIPE_ALL);
}
